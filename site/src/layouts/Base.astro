---
import '../styles/page.css';

interface Props {
  title?: string;
}

const {
  title = "ADS401 Students' Perspective on AI Agents at XJTLU",
} = Astro.props;

const nav = [
  ['#1-project-at-a-glance', '1 At a glance'],
  ['#2-problem-motivation-and-research-questions', '2 Problem & RQs'],
  ['#3-background-and-related-work', '3 Background'],
  ['#4-system-and-evaluation-design', '4 Evaluation design'],
  ['#5-data-preparation-and-analysis-plan', '5 Analysis plan'],
  ['#6-findings', '6 Findings'],
  ['#7-discussion-limitations-and-recommendations-planned', '7 Discussion'],
  ['#8-transparency-and-references', '8 Transparency'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Group A</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta
      name="description"
      content="ADS401 Group A HCI evaluation: awareness, adoption and use of XJTLU AI agents among ADS401 students. Study design, method and status."
    />
  </head>
  <body>
    <header class="site">
      <h1>ADS401 Students' Perspective on AI Agents at XJTLU</h1>
      <p class="subtitle">
        An empirical HCI evaluation of awareness, adoption and use of XJTLU-provided AI agents<br />
        Group A · Hongcheng TANG · Mingjian TAO · Liyuan CHEN · Haode SHEN<br />
        ADS401 Evaluation Methods and Statistics · Xi'an Jiaotong-Liverpool University · 2026–27 Sem1
      </p>
    </header>

    <nav aria-label="Sections">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      ADS401 Group A · Evaluating AI Integration at XJTLU · 2026–27 Sem1 ·
      <a href="https://github.com/LionChenA/ads401">github.com/LionChenA/ads401</a> ·
      Red line: no raw participant data in this repository or site.
    </footer>
  </body>
</html>
