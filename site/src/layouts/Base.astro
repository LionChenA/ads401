---
import '../styles/page.css';

interface Props {
  title?: string;
}

const {
  title = "ADS401 Students' Perspective on AI Agents at XJTLU",
} = Astro.props;

const nav = [
  ['sec-1', '#1-project-at-a-glance', 'At a glance'],
  ['sec-2', '#2-problem-motivation-and-research-questions', 'Problem & RQs'],
  ['sec-3', '#3-background-and-related-work', 'Background'],
  ['sec-4', '#4-system-and-evaluation-design', 'Evaluation design'],
  ['sec-5', '#5-data-preparation-and-analysis-plan', 'Analysis plan'],
  ['sec-6', '#6-findings', 'Findings'],
  ['sec-7', '#7-discussion-limitations-and-recommendations-planned', 'Discussion'],
  ['sec-8', '#8-transparency-and-references', 'Transparency'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Group A</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta
      name="description"
      content="ADS401 Group A HCI evaluation: awareness, adoption and use of XJTLU AI agents among ADS401 students. Study design, method and status."
    />
  </head>
  <body>
    <div class="shell">
      <aside aria-label="Report navigation and status">
        <div class="brand">ADS401 Students' Perspective on AI Agents at XJTLU</div>
        <div class="course">Evaluation Methods · XJTLU · 2026–27</div>

        <div class="h">Contents</div>
        <div class="navwrap">
          {nav.map(([, href, label]) => (
            <a href={href}>
              <span class="n">{href.match(/#(\d)-/)?.[1] ? `§${href.match(/#(\d)-/)[1]}` : '§'}</span>
              {label}
            </a>
          ))}
        </div>
        <div class="h">Materials</div>
        <a class="ext" href="https://github.com/LionChenA/ads401">GitHub repo ↗</a>
        <a class="ext" href="https://github.com/LionChenA/ads401/tree/main/assets/pre2/materials">Survey materials ↗</a>
      </aside>

      <main>
        <div class="journal-head">
          <span>ADS401 · Evaluation Methods and Statistics</span>
          <span>XJTLU · 2026–27</span>
        </div>
        <h1>{title}</h1>
        <p class="dek">
          An empirical HCI evaluation of awareness, adoption and use of
          XJTLU-provided AI agents.
        </p>
        <p class="byline">
          Group A · Hongcheng TANG · Mingjian TAO · Liyuan CHEN · Haode SHEN ·
          Explanatory sequential mixed methods
        </p>
        <slot />
      </main>
    </div>
    <script>
      const navLinks = Array.from(document.querySelectorAll('.navwrap a'));
      const headings = Array.from(document.querySelectorAll('main h2[id]'));

      if (headings.length > 0 && navLinks.length > 0) {
        let ticking = false;

        function updateActiveSection() {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60) {
            navLinks.forEach((link, idx) => {
              link.classList.toggle('active', idx === navLinks.length - 1);
            });
            ticking = false;
            return;
          }

          let activeIndex = 0;
          for (let i = 0; i < headings.length; i++) {
            if (headings[i].getBoundingClientRect().top <= 120) {
              activeIndex = i;
            } else {
              break;
            }
          }

          navLinks.forEach((link, idx) => {
            link.classList.toggle('active', idx === activeIndex);
          });

          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateActiveSection);
            ticking = true;
          }
        }, { passive: true });

        updateActiveSection();
      }
    </script>
  </body>
</html>
