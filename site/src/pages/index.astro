---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ADS401 · Group A</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main>
      <p class="eyebrow">ADS401 · Evaluation Methods and Statistics · Group A</p>
      <h1>Students’ perspective on AI agents at XJTLU</h1>
      <p class="intro">Explore the project’s presentation materials and report.</p>
      <nav aria-label="Project presentations">
        <a href={`${base}/pre3/`}><span>Presentation 03</span><strong>Pre3 · Data story</strong><small>Explore the interactive presentation →</small></a>
        <a href={`${base}/pre2/`}><span>Presentation 02 · Archive</span><strong>Pre2 · Project report</strong><small>Read the archived report →</small></a>
      </nav>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fdfdfa; color: #172327; font: 16px/1.6 Inter, system-ui, sans-serif; }
  main { max-width: 1000px; margin: 0 auto; padding: clamp(3rem, 10vw, 8rem) 1.5rem; }
  .eyebrow { color: #1683a5; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 18ch; font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.1; letter-spacing: -.035em; }
  .intro { color: #687780; font-size: 1.1rem; }
  nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; margin-top: 3rem; }
  nav a { display: flex; flex-direction: column; gap: .8rem; padding: 1.6rem; border: 1px solid #ced5d7; color: inherit; text-decoration: none; }
  nav a:hover, nav a:focus-visible { border-color: #1683a5; background: #eef6f9; }
  nav span { color: #687780; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  nav strong { font-size: 1.35rem; }
  nav small { color: #1683a5; }
</style>
