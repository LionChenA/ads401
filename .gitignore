# Adapted from github/gitignore Node.gitignore for this repo:
# root = Astro web report · slides/ = Slidev deck (source tracked, artifacts not)

# Dependencies
node_modules/

# Build outputs — deployed by GitHub Actions, never committed
dist/
.astro/
.output/
site/public/slides/

# Exported artifacts (rebuilt from source; LMS submissions)
*.pdf
*.pptx
slides/supplementary.html
slides/flow.svg

# Local drafts and temporary files
*.tmp
*.local
*.draft
*.bundle

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS & editors
.DS_Store
Thumbs.db
.vscode/
.idea/
