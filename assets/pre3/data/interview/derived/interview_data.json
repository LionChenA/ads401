    },
    {
      "n": 2,
      "title": "事务用校内、学习用外部",
      "en": "Official tasks → campus AI; learning → external",
      "quan": "问卷：校内 AI 唯一领先的任务 = 校内资源检索",
      "qual": "P002：图书馆查试卷 / e-Bridge 查 Ethics 表；学习全用豆包"
    },
    {
      "n": 3,
      "title": "用 AI 核验 AI，而非查教材",
      "en": "Verify with AI, not with textbooks",
      "quan": "问卷 Q12 核查频率低 + Q13 信任中性",
      "qual": "P002/P003/P006 跨 AI 交叉验证；P004 付费→信任→不核查"
    },
